          :rationale "Emits self-contained React TypeScript .tsx module")
    (:sym :name "jsx-attr-key" :kind :fn :tokens 3
          :rationale "Converts HTML attribute names to React camelCase JSX props")
    (:sym :name "is-void-tag?" :kind :fn :tokens 3
          :rationale "Predicate checking if HTML tag is void self-closing element")
    (:sym :name "is-component-tag?" :kind :fn :tokens 3
          :rationale "Predicate testing if tag is a custom React component")
    (:sym :name "vnode-is-comp?" :kind :fn :tokens 3
          :rationale "Predicate testing if VNode represents a component")
    (:sym :name "props-to-attrs" :kind :fn :tokens 3
          :rationale "Converts Props dictionary to list of HTML attribute strings")
    (:sym :name "is-valid-node" :kind :fn :tokens 3
          :rationale "Validates structural integrity of VNode")
    (:sym :name "make-ax-node" :kind :fn :tokens 3
          :rationale "Constructs accessibility tree node with role and bounding box")
    (:sym :name "is-retained-attr?" :kind :fn :tokens 3
          :rationale "Predicate testing if attribute is semantic and must be retained in downsampling")
    (:sym :name "should-prune-tag?" :kind :fn :tokens 3
          :rationale "Predicate testing if tag is non-content decorative boilerplate")
    (:sym :name "is-redundant-wrapper?" :kind :fn :tokens 3
          :rationale "Predicate testing if container element can be collapsed without losing semantics")
    (:sym :name "diff-children-indexed" :kind :fn :tokens 3
          :rationale "Computes indexed children diff using key reconciliation")
    (:sym :name "format-diff-frame" :kind :fn :tokens 3
          :rationale "Formats DomDiff into human-readable compact patch frame")
    (:sym :name "emit-react-tsx" :kind :fn :tokens 3
          :rationale "Emits complete React 19 component file")
    (:sym :name "emit-vue-sfc" :kind :fn :tokens 3
          :rationale "Emits Vue 3 Single File Component markup")
    (:sym :name "emit-svelte-component" :kind :fn :tokens 3
          :rationale "Emits Svelte 5 runes component markup")
    (:sym :name "emit-ssr-html" :kind :fn :tokens 3
          :rationale "Renders VNode tree into server-side HTML string")
    (:sym :name "emit-swiftui-view" :kind :fn :tokens 3
          :rationale "Emits complete SwiftUI 6 View struct from VNode tree")
    (:sym :name "emit-compose-composable" :kind :fn :tokens 3
          :rationale "Emits complete Jetpack Compose @Composable function from VNode tree")
    (:sym :name "vue-attr-key" :kind :fn :tokens 3
          :rationale "Converts attribute name to Vue template binding syntax")
    (:sym :name "svelte-attr-key" :kind :fn :tokens 3
          :rationale "Converts attribute name to Svelte template syntax")
