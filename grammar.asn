    ;; 2-Token Symbols (with :rationale)
    (:sym :name "render-card" :kind :fn :tokens 2
          :rationale "Renders Card component VNode tree from CardProps")
    (:sym :name "make-particle" :kind :fn :tokens 2
          :rationale "Initializes 2D physics particle with position and velocity")
    (:sym :name "coulomb-repulsion" :kind :fn :tokens 2
          :rationale "Calculates electrostatic repulsive force vector between nodes")
